# ─────────────────────────────────────────────
# Craftovon ReplyBridge — .env.example
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Meta / Instagram ──────────────────────────
META_APP_ID=                        # From Meta App Dashboard
META_APP_SECRET=                    # From Meta App Dashboard (keep in KMS in prod)
META_APP_CONFIG_ID=                 # Business Login configuration ID
WEBHOOK_VERIFY_TOKEN=               # Random string — must match Meta App Dashboard webhook token
GRAPH_VERSION=v21.0                 # META-VERIFIED: v21.0 current as of Sep 2026
# META-VERIFIED: Scopes for Instagram Login path (deprecated legacy 'business_*' Jan 27 2025):
#   instagram_business_basic, instagram_business_manage_comments, instagram_business_manage_messages
# META-VERIFIED: Private reply window = 7 days from comment; Live = only during broadcast
# META-VERIFIED: Rate limit = 100 calls/sec text/link per IG professional account; throttle code = 80002

# button-template attempt first, fall back to plain text on error
PRIVATE_REPLY_BUTTON_MODE=attempt   # attempt | text_only

# ── Core ──────────────────────────────────────
NODE_ENV=development
BASE_URL=http://localhost:5173       # Frontend URL (prod: https://app.craftovon.com)
API_URL=http://localhost:8080        # API URL    (prod: https://api.craftovon.com)
PORT=8080

MONGO_URI=mongodb://localhost:27017/replybridge
REDIS_URL=redis://localhost:6379

JWT_SECRET=                         # Min 64 random bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 32 bytes base64 — use KMS (AWS/GCP) in prod; openssl rand -base64 32
ENCRYPTION_KEY=

# ── Rate limits ───────────────────────────────
RATE_LIMIT_DMS_PER_MIN_PER_IG=90
PRIVATE_REPLIES_PER_HOUR_PER_IG=700    # Advisory; auto-throttle on error 80002

# ── Email ─────────────────────────────────────
SMTP_URL=                           # e.g. smtps://user:pass@smtp.resend.com:465
EMAIL_FROM=noreply@craftovon.com

# ── Billing ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=                  # Uncomment to use Razorpay instead
# RAZORPAY_KEY_SECRET=

# ── Workers ───────────────────────────────────
WORKERS_METRICS_PORT=9090
TOKEN_REFRESH_CRON=0 3 * * *       # Daily 03:00 UTC
